# Usado pelo latexmk local e pelo Overleaf (Menu → Compiler: pdfLaTeX).
$pdf_mode = 1;
$bibtex_use = 2;
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
# Data fixa nos metadados e no /ID do PDF: recompilar sem mudar o fonte gera o
# mesmo arquivo, byte a byte, e o PDF versionado não aparece como modificado.
$ENV{SOURCE_DATE_EPOCH} = '1792065600';
$ENV{FORCE_SOURCE_DATE} = '1';
